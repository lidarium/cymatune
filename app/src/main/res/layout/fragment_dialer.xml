<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Warning Banner at the top -->
    <com.cymatune.ui.WarningBannerView
        android:id="@+id/warningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TabLayout for Dialer/Calls/Contacts -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/dialerTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/warningBanner"
        app:tabIndicatorColor="@color/primary_neon"
        app:tabSelectedTextColor="@color/primary_neon"
        app:tabTextColor="@color/text_tertiary" />

    <!-- ViewPager for tab pages -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dialerViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialerTabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
