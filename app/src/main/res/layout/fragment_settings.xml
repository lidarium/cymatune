        <!-- Color Guide Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/colorGuideCard"
            style="@style/CardGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/notificationSettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COLOR GUIDE" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Colors indicate threat confidence level:"
                    android:textSize="14sp" />

                <!-- Red - Critical -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/warning_red" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="RED - Critical threat (>80%)"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Orange -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/alert_orange" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="ORANGE - High confidence (>60%)"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Yellow -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/warning_yellow" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="YELLOW - Medium confidence (40-60%)"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Lime -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/alert_lime" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="LIME - Low confidence (20-40%)"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Cyan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/teal_200" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="CYAN - Very low confidence (&lt;20%)"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Green -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/primary_neon" />
                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="GREEN - Safe (no alerts)"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Terminology Explanations Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/terminologyCard"
            style="@style/CardGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/colorGuideCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TECHNICAL TERMS" />

                <TextView
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Understanding these terms helps you interpret the app's analysis:"
                    android:textSize="14sp" />

                <!-- RSRP Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RSRP (Reference Signal Received Power)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Signal strength measurement. Lower (more negative) values mean weaker signals. -80dBm to -90dBm is good, -100dBm or lower is poor."
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- RSRQ Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RSRQ (Reference Signal Received Quality)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Signal quality measurement. Combines signal strength and interference. -10dB to -5dB is excellent, -15dB to -10dB is good, below -20dB is poor."
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- SINR Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SINR (Signal to Interference plus Noise Ratio)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Signal quality relative to noise and interference. Higher values mean better quality. 20dB+ is excellent, 10-20dB is good, 0-10dB is poor."
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Accuracy Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accuracy"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="How certain the app is about its analysis. Based on data quality, signal consistency, and pattern recognition. Higher values mean more reliable detection."
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Tower ID Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tower ID (CID/LAC/MCC/MNC)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Unique identifiers for each cell tower. CID=Cell ID, LAC=Location Area Code, MCC=Mobile Country Code, MNC=Mobile Network Code."
                        android:textSize="12sp" />
                </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- About Button (moved from Actions Card) -->
    <Button
        android:id="@+id/btnAbout"
        style="@style/NeonButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="About Cymatune"
        android:textColor="@color/text_primary"
        app:strokeColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/terminologyCard" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
