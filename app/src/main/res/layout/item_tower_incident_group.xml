<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cardBackgroundDark"
    android:padding="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Warning Type Header (Expandable) -->
    <LinearLayout
        android:id="@+id/layoutTowerIncidentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">

        <!-- Warning Type Icon/Badge -->
        <TextView
            android:id="@+id/tvTowerBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="R"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/circle_badge"
            android:backgroundTint="#FF9500"
            android:textSize="16sp" />

        <!-- Warning Type Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTowerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tower 842792"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/tvTowerAlertCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="3 incidents"
                android:textSize="13sp"
                android:textColor="@color/textSecondary" />
            
            <TextView
                android:id="@+id/tvWarningExplanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Explanation about the warning"
                android:textSize="12sp"
                android:textColor="@color/textTertiary"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Learn More Button -->
        <TextView
            android:id="@+id/tvLearnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:text="Learn More"
            android:textSize="12sp"
            android:textColor="@color/accent_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <!-- Unarchive Icon (Archive mode only) -->
        <ImageView
            android:id="@+id/imgTowerUnarchive"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_undo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:tint="@color/textSecondary"
            android:contentDescription="Unarchive" />

        <!-- Delete Icon (Archive mode only) -->
        <ImageView
            android:id="@+id/imgTowerDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:tint="#FF3B30"
            android:contentDescription="Delete" />

        <!-- Expand/Collapse Icon -->
        <ImageView
            android:id="@+id/imgTowerExpand"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_expand"
            android:tint="@color/textSecondary"
            android:contentDescription="Expand/Collapse" />
    </LinearLayout>

    <!-- Warning Instances List -->
    <LinearLayout
        android:id="@+id/layoutTowerAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <!-- Individual timestamps will be added here dynamically -->

    </LinearLayout>

</LinearLayout>
