<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:padding="24dp">

    <ImageView
        android:id="@+id/detailsIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/status_dot_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/detailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Tower 47108"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/detailsIcon"
        app:layout_constraintTop_toTopOf="@id/detailsIcon" />

    <TextView
        android:id="@+id/detailsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="High Trust"
        android:textColor="@color/primary_neon"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/detailsIcon"
        app:layout_constraintTop_toBottomOf="@id/detailsTitle" />

    <!-- Metrics Grid -->
    <LinearLayout
        android:id="@+id/metricsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/detailsIcon">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSRP"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/detailsRsrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-85"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSRQ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/detailsRsrq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-12"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCURACY"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/detailsConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98%"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/trustFactorsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="TRUST FACTORS"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metricsContainer" />

    <TextView
        android:id="@+id/accuracyExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Accuracy indicates how certain the app is about this tower's status. Higher values mean more certainty. This is based on signal analysis, location patterns, and network behavior."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/trustFactorsLabel" />

    <TextView
        android:id="@+id/trustFactorsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• Known Location (+20)\n• Long Duration (+10)"
        android:textColor="@color/text_primary"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/accuracyExplanation" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btnLocate"
        style="@style/NeonButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Locate on Map"
        android:drawableStart="@android:drawable/ic_dialog_map"
        android:drawableTint="@color/primary_neon"
        app:layout_constraintTop_toBottomOf="@id/trustFactorsList" />

    <!-- TODO: Report False Positive button - Feature to be implemented in next version
    <Button
        android:id="@+id/btnReport"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="Report False Positive"
        android:textColor="@color/warning_red"
        app:strokeColor="@color/warning_red"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnClose"
        app:layout_constraintTop_toBottomOf="@id/btnLocate" />
    -->

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/surface_dark"
        android:text="Close"
        android:textColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLocate" />

</androidx.constraintlayout.widget.ConstraintLayout>
