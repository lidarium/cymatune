    <string name="background_location_permission_title">Background Location Access</string>
    <string name="background_location_permission_description">Cymatune needs continuous location access to monitor cellular tower signals even when the app is not in use. This helps detect fake towers that may appear and disappear rapidly.</string>
    
    <string name="precise_location_permission_title">Precise Location Access</string>
    <string name="precise_location_permission_description">Exact GPS coordinates are essential to pinpoint the precise location and identity of nearby towers. This enables accurate triangulation and detection of suspicious tower activity.</string>
    
    <string name="notification_permission_title">Notification Permission</string>
    <string name="notification_permission_description">Receive immediate alerts about important events like potential fake tower detection or significant changes in network connectivity. Notifications help keep you informed about security threats.</string>
    
    <string name="phone_permission_title">Phone State Access</string>
    <string name="phone_permission_description">Access to phone state information is essential for reading network operator details, signal strength, and other critical telephony data needed for comprehensive tower analysis and fake tower detection.</string>
    
